# Copy to terraform.tfvars (git-ignored) and fill in real values, or set the
# equivalent TF_VAR_* environment variables instead of committing secrets.

project     = "novacart"
environment = "dev"
location    = "eastus"

tags = {
  owner = "devops-cohort"
}

# Required, no default: set via terraform.tfvars (git-ignored) or
# TF_VAR_postgres_administrator_password. Never commit a real password.
# postgres_administrator_password = "REPLACE_ME"

postgres_administrator_login = "novacartadmin"
postgres_database_name       = "novacart"

# Build and push images first, then set the tags you pushed:
#   az acr build --registry <acr-name> --image novacart-backend:dev-1 ./backend
#   az acr build --registry <acr-name> --image novacart-frontend:dev-1 ./frontend
# (the ACR name is only known after the first apply that creates it -- see
# the container_registry_login_server output)
backend_image_tag  = "REPLACE_ME"
frontend_image_tag = "REPLACE_ME"
